# gh 계정을 이 레포에서 minestero00 으로 고정한다.
#
# 왜 필요한가: `gh auth switch` 는 **전역** 활성 계정을 바꾼다. 레포별 자동
# 전환 기능이 gh 에 없어서, 다른 프로젝트에서 계정을 바꾸면 여기 돌아왔을 때도
# 그 계정이 남아 `Could not resolve to a Repository` 로 실패한다(실제로 겪음).
# GH_TOKEN 이 있으면 gh 는 활성 계정 대신 그 토큰을 쓰므로 전역 상태와 무관해진다.
#
# 토큰은 파일에 적지 않고 keyring 에서 런타임에 꺼낸다 — .envrc 에 시크릿이
# 남지 않으므로 커밋해도 안전하다.
#
# 최초 1회: direnv allow
export GH_TOKEN="$(gh auth token --user minestero00 2>/dev/null)"
if [ -z "$GH_TOKEN" ]; then
  echo "⚠️  gh 에 minestero00 계정이 없다: gh auth login --user minestero00" >&2
fi
